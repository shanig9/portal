PORT=3000
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional: use 6 on an IPv6-only hotspot; leave empty for normal hosting.
CLOUDINARY_IP_FAMILY=4
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to a private Firebase service-account file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# On Vercel set this to the complete private service-account JSON in dashboard settings.
# Keep it empty locally when using GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGINS=https://example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key



