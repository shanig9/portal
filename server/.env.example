PORT=3000
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: use 6 on an IPv6-only hotspot; leave empty for normal hosting.
CLOUDINARY_IP_FAMILY=
FIREBASE_PROJECT_ID=job-portal-54254
# Absolute path to a private Firebase service-account file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
# On Vercel set this to the complete private service-account JSON in dashboard settings.
# Keep it empty locally when using GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGINS=http://localhost:8080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET
